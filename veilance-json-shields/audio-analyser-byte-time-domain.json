{
  "schemaVersion": 1,
  "id": "audio-analyser-byte-time-domain",
  "name": "Audio byte-waveform farbling",
  "category": "Web Audio",
  "description": "Applies small, session-consistent changes to selected byte waveform values after an analyser copies them into the page's buffer.",
  "surface": "Web Audio analyser",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "audio",
    "api": "AnalyserNode",
    "action": "get-byte-time-domain-data"
  },
  "protection": {
    "strategy": "typed-array-farbling",
    "parameters": {
      "maximumEdits": 8,
      "delta": 1
    }
  }
}
