{
  "schemaVersion": 1,
  "id": "webgl-unmasked-renderer",
  "name": "WebGL renderer normalization",
  "category": "WebGL",
  "description": "Returns a generic software renderer profile when a page requests the unmasked graphics renderer.",
  "surface": "WebGL renderer",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "webgl",
    "api": "WebGL",
    "action": "renderer-query",
    "detail": {
      "parameter": "UNMASKED_RENDERER_WEBGL"
    }
  },
  "protection": {
    "strategy": "replace-string",
    "parameters": {
      "value": "ANGLE (Google, Vulkan 1.3.0 (SwiftShader Device (Subzero)), SwiftShader driver)"
    }
  }
}
