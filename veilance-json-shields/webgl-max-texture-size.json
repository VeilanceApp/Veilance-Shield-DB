{
  "schemaVersion": 1,
  "id": "webgl-max-texture-size",
  "name": "Texture-size cap",
  "category": "WebGL capabilities",
  "description": "Caps the reported two-dimensional texture size at a common value without ever overstating the device's actual capability.",
  "surface": "WebGL capabilities",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "webgl",
    "api": "WebGL",
    "action": "capability-query",
    "detail": { "parameter": "MAX_TEXTURE_SIZE" }
  },
  "protection": {
    "strategy": "cap-number",
    "parameters": { "maximum": 4096 }
  }
}
