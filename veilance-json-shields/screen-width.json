{
  "schemaVersion": 1,
  "id": "screen-width",
  "name": "Screen width bucketing",
  "category": "Screen characteristics",
  "description": "Rounds screen and available-screen width values to the nearest 100 CSS pixels within a compatibility-safe range.",
  "surface": "Screen geometry",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "screen-characteristics",
    "api": "Screen",
    "actions": [
      "read-width",
      "read-avail-width"
    ]
  },
  "protection": {
    "strategy": "bucket-number",
    "parameters": {
      "step": 100,
      "minimum": 320,
      "maximum": 3840,
      "rounding": "nearest",
      "preserveZero": true
    }
  }
}
