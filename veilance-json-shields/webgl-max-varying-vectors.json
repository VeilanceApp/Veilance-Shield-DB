{
  "schemaVersion": 1,
  "id": "webgl-max-varying-vectors",
  "name": "Varying-vector cap",
  "category": "WebGL capabilities",
  "description": "Caps the reported varying-vector limit at a common value without ever overstating the device's actual capability.",
  "surface": "WebGL capabilities",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "webgl",
    "api": "WebGL",
    "action": "capability-query",
    "detail": { "parameter": "MAX_VARYING_VECTORS" }
  },
  "protection": {
    "strategy": "cap-number",
    "parameters": { "maximum": 16 }
  }
}
