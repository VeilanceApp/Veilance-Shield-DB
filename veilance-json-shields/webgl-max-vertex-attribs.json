{
  "schemaVersion": 1,
  "id": "webgl-max-vertex-attribs",
  "name": "Vertex-attribute cap",
  "category": "WebGL capabilities",
  "description": "Caps the reported vertex-attribute limit at a common value without ever overstating the device's actual capability.",
  "surface": "WebGL capabilities",
  "defaultEnabled": true,
  "match": {
    "indicatorId": "webgl",
    "api": "WebGL",
    "action": "capability-query",
    "detail": { "parameter": "MAX_VERTEX_ATTRIBS" }
  },
  "protection": {
    "strategy": "cap-number",
    "parameters": { "maximum": 16 }
  }
}
